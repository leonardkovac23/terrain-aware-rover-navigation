<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="terrain_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="flat_ground">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry>
            <box>
              <size>32 32 0.08</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>0.4</mu2>
              </ode>
              <bullet>
                <friction>1.0</friction>
                <friction2>0.4</friction2>
                <rolling_friction>0.03</rolling_friction>
              </bullet>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>10.0</kd>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>32 32 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.48 0.35 1</ambient>
            <diffuse>0.35 0.48 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Static objects scattered over a smaller flat terrain area. -->
    <include>
      <name>pine_tree_1</name>
      <pose>-10.5 -8.0 0 0 0 0.35</pose>
      <uri>model://terrain_rover_sim/models/world_models/pine_tree</uri>
    </include>
    <include>
      <name>pine_tree_2</name>
      <pose>-5.8 7.4 0 0 0 2.10</pose>
      <uri>model://terrain_rover_sim/models/world_models/pine_tree</uri>
    </include>
    <include>
      <name>pine_tree_3</name>
      <pose>8.6 -5.3 0 0 0 -1.20</pose>
      <uri>model://terrain_rover_sim/models/world_models/pine_tree</uri>
    </include>
    <include>
      <name>pine_tree_4</name>
      <pose>11.0 8.8 0 0 0 1.45</pose>
      <uri>model://terrain_rover_sim/models/world_models/pine_tree</uri>
    </include>

    <include>
      <name>casual_female_1</name>
      <pose>2.5 -9.2 0 0 0 1.57</pose>
      <uri>model://terrain_rover_sim/models/world_models/casual_female</uri>
    </include>
    <include>
      <name>casual_female_2</name>
      <pose>-9.1 3.9 0 0 0 -0.50</pose>
      <uri>model://terrain_rover_sim/models/world_models/casual_female</uri>
    </include>
    <include>
      <name>casual_female_3</name>
      <pose>6.4 6.1 0 0 0 2.65</pose>
      <uri>model://terrain_rover_sim/models/world_models/casual_female</uri>
    </include>
    <include>
      <name>casual_female_4</name>
      <pose>-1.8 10.7 0 0 0 -2.30</pose>
      <uri>model://terrain_rover_sim/models/world_models/casual_female</uri>
    </include>

    <include>
      <name>shelf_1</name>
      <pose>-11.0 -1.5 0 0 0 0.0</pose>
      <uri>model://terrain_rover_sim/models/world_models/aws_robomaker_warehouse_ShelfD_01</uri>
    </include>
    <include>
      <name>shelf_2</name>
      <pose>-3.2 -5.8 0 0 0 1.57</pose>
      <uri>model://terrain_rover_sim/models/world_models/aws_robomaker_warehouse_ShelfD_01</uri>
    </include>
    <include>
      <name>shelf_3</name>
      <pose>4.4 0.8 0 0 0 -0.35</pose>
      <uri>model://terrain_rover_sim/models/world_models/aws_robomaker_warehouse_ShelfD_01</uri>
    </include>
    <include>
      <name>shelf_4</name>
      <pose>10.2 -10.0 0 0 0 0.90</pose>
      <uri>model://terrain_rover_sim/models/world_models/aws_robomaker_warehouse_ShelfD_01</uri>
    </include>
  </world>
</sdf>

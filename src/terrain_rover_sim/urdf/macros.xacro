<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rover_base" params="">

    <xacro:macro name="rocker_link" params="name">
      <link name="rocker_${name}_link">
        <inertial>
          <mass value="1.387336"/>
          <origin xyz="0 0.01346 -0.06506"/>
          <inertia
            ixx="0.002956" ixy="-0.000001489324" ixz="-0.000008103407"
            iyy="0.02924"  iyz="0.00007112"
            izz="0.02832"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://terrain_rover_sim/models/leo_models/Rocker.dae"/>
          </geometry>
        </visual>
        <collision>
          <geometry>
            <mesh filename="package://terrain_rover_sim/models/leo_models/Rocker_outline.stl"/>
          </geometry>
        </collision>
      </link>
    </xacro:macro>

    <xacro:macro name="wheel_link" params="name model"> 
      <link name="wheel_${name}_link">
        <inertial>
          <mass value="0.283642"/>
          <origin xyz="0 0.030026 0"/>
          <inertia
            ixx="0.000391"  ixy="0.00000123962" ixz="5.52582e-7"
            iyy="0.0004716" iyz="-0.000002082042"
            izz="0.000391"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://terrain_rover_sim/models/leo_models/Wheel${model}.dae"/>
          </geometry>
        </visual>
        <collision>
          <origin xyz="0 0.04485 0" rpy="${pi/2} 0 0"/>
          <geometry>
            <cylinder radius="0.057" length="0.07"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0 0.04485 0" rpy="${pi/2} 0 0"/>
          <geometry>
            <cylinder radius="0.0625" length="0.04"/>
          </geometry>
        </collision>
      </link>
    </xacro:macro>

    <!-- LINKS -->
    <link name="base_footprint"/>

    <link name="base_link">
      <inertial>
        <mass value="1.584994"/>
        <origin xyz="-0.019662 0.011643 -0.031802"/>
        <inertia
          ixx="0.01042" ixy="0.001177" ixz="-0.0008871"
          iyy="0.01045" iyz="0.0002226"
          izz="0.01817"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://terrain_rover_sim/models/leo_models/Chassis.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://terrain_rover_sim/models/leo_models/Chassis_outline.stl"/>
        </geometry>
      </collision>
    </link>

    <xacro:rocker_link name="L"/>
    <xacro:rocker_link name="R"/>
    <xacro:wheel_link name="FL" model="A"/>
    <xacro:wheel_link name="RL" model="A"/>
    <xacro:wheel_link name="FR" model="B"/>
    <xacro:wheel_link name="RR" model="B"/>

    <link name="depth_camera_frame">
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0"/>
        <inertia
          ixx="0.00002" ixy="0.0" ixz="0.0"
          iyy="0.00002" iyz="0.0"
          izz="0.00002"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.045 0.065 0.035"/>
        </geometry>
        <material name="depth_camera_black">
          <color rgba="0.02 0.02 0.025 1"/>
        </material>
      </visual>
      <visual>
        <origin xyz="0.026 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <cylinder radius="0.014" length="0.01"/>
        </geometry>
        <material name="depth_camera_lens">
          <color rgba="0.05 0.18 0.45 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.045 0.065 0.035"/>
        </geometry>
      </collision>
    </link>

    <link name="depth_camera_optical_frame"/>

    <link name="imu_frame"/>

    <link name="lidar_link">
			<inertial>
				<mass value="0.1"/>
				<origin xyz="0 0 0"/>
				<inertia
				  ixx="0.0001" ixy="0.0" ixz="0.0"
				  iyy="0.0001" iyz="0.0"
				  izz="0.0001"/>
			</inertial>

			<visual>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
				  <cylinder radius="0.05" length="0.05"/>
				</geometry>
				<material name="black">
				  <color rgba="0.02 0.02 0.02 1"/>
				</material>
			</visual>

			<collision>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
				  <cylinder radius="0.04" length="0.05"/>
				</geometry>
			</collision>
		</link>

    <!-- JOINTS -->

    <joint name="base_joint" type="fixed">
      <origin xyz="0 0 0.19783" rpy="0 0 0"/>
      <parent link="base_footprint"/>
      <child link="base_link"/>
    </joint>

    <joint name="rocker_L_joint" type="revolute">
      <origin xyz="0.00263 0.14167 -0.04731" rpy="0 0 ${pi}"/>
      <parent link="base_link"/>
      <child link="rocker_L_link"/>
      <axis xyz="0 1 0"/>
      <limit effort="100.0" lower="-0.24" upper="0.24" velocity="100.0"/>
      <dynamics friction="1.0" damping="0.1"/>
    </joint>

    <joint name="rocker_R_joint" type="revolute">
      <origin xyz="0.00263 -0.14167 -0.04731" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="rocker_R_link"/>
      <axis xyz="0 1 0"/>
      <limit effort="100.0" lower="-0.24" upper="0.24" velocity="100.0"/>
      <dynamics friction="1.0" damping="0.1"/> 
      <mimic joint="rocker_L_joint"/>
    </joint>

    <joint name="wheel_FL_joint" type="continuous">
      <origin xyz="-0.15256 -0.08214 -0.08802" rpy="0 0 0"/>
      <parent link="rocker_L_link"/>
      <child link="wheel_FL_link"/>
      <axis xyz="0 -1 0"/>
      <limit effort="2.0" velocity="12.0"/>
      <dynamics friction="0.3125" damping="0.1"/>
    </joint>

    <joint name="wheel_RL_joint" type="continuous">
      <origin xyz="0.15256 -0.08214 -0.08802" rpy="0 0 0"/>
      <parent link="rocker_L_link"/>
      <child link="wheel_RL_link"/>
      <axis xyz="0 -1 0"/>
      <limit effort="2.0" velocity="12.0"/>
      <dynamics friction="0.3125" damping="0.1"/>
    </joint>

    <joint name="wheel_FR_joint" type="continuous">
      <origin xyz="0.15256 -0.08214 -0.08802" rpy="0 0 0"/>
      <parent link="rocker_R_link"/>
      <child link="wheel_FR_link"/>
      <axis xyz="0 1 0"/>
      <limit effort="2.0" velocity="12.0"/>
      <dynamics friction="0.3125" damping="0.1"/>
    </joint>

    <joint name="wheel_RR_joint" type="continuous">
      <origin xyz="-0.15256 -0.08214 -0.08802" rpy="0 0 0"/>
      <parent link="rocker_R_link"/>
      <child link="wheel_RR_link"/>
      <axis xyz="0 1 0"/>
      <limit effort="2.0" velocity="12.0"/>
      <dynamics friction="0.3125" damping="0.1"/> 
    </joint>

    <joint name="depth_camera_joint" type="fixed">
      <origin xyz="0.15 0 0.26" rpy="0 0.45 0"/>
      <parent link="base_link"/>
      <child link="depth_camera_frame"/>
    </joint>

    <joint name="depth_camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-${pi/2} 0.0 -${pi/2}"/>
      <parent link="depth_camera_frame"/>
      <child link="depth_camera_optical_frame"/>
    </joint>

    <joint name="imu_joint" type="fixed">
      <origin xyz="0.0628 -0.0314 -0.0393" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="imu_frame"/>
    </joint>
    
    <joint name="lidar_joint" type="fixed">
			<origin xyz="0.08 0 0.2" rpy="0 0 0"/>
			<parent link="base_link"/>
			<child link="lidar_link"/>
		</joint>

  </xacro:macro>


  <!-- GAZEBO -->
  <xacro:macro name="rover_gazebo" params="">

    <!-- base ODE properties -->
    <gazebo reference="base_footprint">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>0.3</mu>
              <mu2>0.3</mu2>
            </ode>
            <bullet>
              <friction>0.3</friction>
              <friction2>0.3</friction2>
              <rolling_friction>0.1</rolling_friction>
            </bullet>
          </friction>
        </surface>
      </collision>
    </gazebo>

    <gazebo reference="base_link">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>0.3</mu>
              <mu2>0.3</mu2>
            </ode>
            <bullet>
              <friction>0.3</friction>
              <friction2>0.3</friction2>
              <rolling_friction>0.1</rolling_friction>
            </bullet>
          </friction>
        </surface>
      </collision>
    </gazebo>

    <!-- rocker ODE properties -->
    <gazebo reference="rocker_L_link">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>0.3</mu>
              <mu2>0.3</mu2>
            </ode>
            <bullet>
              <friction>0.3</friction>
              <friction2>0.3</friction2>
              <rolling_friction>0.1</rolling_friction>
            </bullet>
          </friction>
        </surface>
      </collision>
    </gazebo>

    <gazebo reference="rocker_R_link">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>0.3</mu>
              <mu2>0.3</mu2>
            </ode>
            <bullet>
              <friction>0.3</friction>
              <friction2>0.3</friction2>
              <rolling_friction>0.1</rolling_friction>
            </bullet>
          </friction>
        </surface>
      </collision>
    </gazebo>
    <!-- wheel properties -->
    <gazebo reference="wheel_FL_link">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>3.0</mu>
              <mu2>3.0</mu2>
            </ode>
            <bullet>
              <friction>3.0</friction>
              <friction2>3.0</friction2>
              <rolling_friction>0.2</rolling_friction>
            </bullet>
          </friction>
        </surface>
      </collision>
    </gazebo>

    <gazebo reference="wheel_FR_link">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>3.0</mu>
              <mu2>3.0</mu2>
            </ode>
            <bullet>
              <friction>3.0</friction>
              <friction2>3.0</friction2>
              <rolling_friction>0.2</rolling_friction>
            </bullet>
          </friction>
        </surface>
      </collision>
    </gazebo>

    <gazebo reference="wheel_RL_link">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>3.0</mu>
              <mu2>3.0</mu2>
            </ode>
            <bullet>
              <friction>3.0</friction>
              <friction2>3.0</friction2>
              <rolling_friction>0.2</rolling_friction>
            </bullet>
          </friction>
        </surface>
      </collision>
    </gazebo>

    <gazebo reference="wheel_RR_link">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>3.0</mu>
              <mu2>3.0</mu2>
            </ode>
            <bullet>
              <friction>3.0</friction>
              <friction2>3.0</friction2>
              <rolling_friction>0.2</rolling_friction>
            </bullet>
          </friction>
        </surface>
      </collision>
    </gazebo>

    <!-- forward RGB-D camera mounted just below the 3D lidar -->
    <gazebo reference="depth_camera_frame">
      <sensor name="rgbd_camera" type="rgbd_camera">
          <always_on>1</always_on>
          <camera name="rover_rgbd_camera">
              <horizontal_fov>2.0</horizontal_fov>
              <image>
                  <width>640</width>
                  <height>480</height>
              </image>
              <clip>
                  <near>0.3</near>
                  <far>100</far>
              </clip>
              <optical_frame_id>depth_camera_optical_frame</optical_frame_id>
          </camera>
          <update_rate>10</update_rate>
          <visualize>false</visualize>
          <topic>rgbd_camera</topic>
      </sensor>
    </gazebo>

    <gazebo reference="depth_camera_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <!-- rocker differential -->
    <gazebo>
      <plugin name="leo_gz::DifferentialSystem" filename="libleo_gz_differential_plugin.so">
        <jointA>rocker_L_joint</jointA>
        <jointB>rocker_R_joint</jointB>
        <forceConstant>100.0</forceConstant>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin
        filename="libgz-sim-joint-state-publisher-system.so"
        name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
      </plugin>
    </gazebo>

    <gazebo reference="imu_frame">
      <sensor type="imu" name="rover_imu_sensor">
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <topic>imu/data_raw</topic>
        <always_on>1</always_on>
        <gz_frame_id>imu_frame</gz_frame_id>
      </sensor>
    </gazebo>
    
		<!-- 3D LIDAR GAZEBO -->
		<gazebo reference="lidar_link">
			<sensor name="lidar_3d" type="gpu_lidar">
				<update_rate>20</update_rate>
				<topic>scan</topic>
				<gz_frame_id>lidar_link</gz_frame_id>
				<always_on>true</always_on>
				<visualize>false</visualize>

				<lidar>
				  <scan>
				    <horizontal>
				      <samples>720</samples>
				      <resolution>1</resolution>
				      <min_angle>-3.14159</min_angle>
				      <max_angle>3.14159</max_angle>
				    </horizontal>

				    <vertical>
				      <samples>64</samples>
				      <resolution>1</resolution>
				      <min_angle>-0.55</min_angle>
				      <max_angle>0.30</max_angle>
				    </vertical>
				    
				    
				  </scan>

				  <range>
				    <min>0.20</min>
				    <max>8.0</max>
				    <resolution>0.01</resolution>
				  </range>

				  <noise>
				    <type>gaussian</type>
				    <mean>0.0</mean>
				    <stddev>0.0</stddev>
				  </noise>

				  <frame_id>lidar_link</frame_id>
				</lidar>
			</sensor>
		</gazebo>
						
    <gazebo>    
      <plugin
        filename="libgz-sim-diff-drive-system.so"
        name="gz::sim::systems::DiffDrive">
        <left_joint>wheel_FL_joint</left_joint>
        <right_joint>wheel_FR_joint</right_joint>
        <left_joint>wheel_RL_joint</left_joint>
        <right_joint>wheel_RR_joint</right_joint>
        <wheel_separation>0.358</wheel_separation>
        <wheel_radius>0.0625</wheel_radius>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        
        <odom_publish_frequency>30</odom_publish_frequency>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
				<publish_odom_tf>false</publish_odom_tf>
        <max_linear_acceleration>2.5</max_linear_acceleration>
        <max_angular_acceleration>3</max_angular_acceleration>
        <min_linear_acceleration>-2.5</min_linear_acceleration>
        <min_angular_acceleration>-3</min_angular_acceleration>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="rover_sim" params="">

    <xacro:rover_base/>
    <xacro:rover_gazebo/>

  </xacro:macro>

</robot>
